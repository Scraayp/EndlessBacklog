{
  "name": "@endlessbacklog/backend",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "seed:demo": "sequelize-cli db:seed:all"
  },
  "dependencies": {
    "@endlessbacklog/shared": "workspace:*",
    "express": "^5.0.1",
    "sequelize": "^6.37.5",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "mariadb": "^3.4.0",
    "socket.io": "^4.8.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "ioredis": "^5.4.1",
    "bullmq": "^5.34.0",
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "nodemailer": "^9.1.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-github2": "^0.1.12",
    "passport-microsoft": "^2.1.0",
    "passport-discord": "^0.1.4",
    "jsonwebtoken": "^9.0.2",
    "argon2": "^0.41.1",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.5.0",
    "rate-limit-redis": "^4.2.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "dotenv": "^16.4.7",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@endlessbacklog/config-typescript": "workspace:*",
    "@endlessbacklog/config-eslint": "workspace:*",
    "eslint": "^9.17.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-github2": "^1.2.9",
    "@types/uuid": "^10.0.0",
    "sequelize-cli": "^6.6.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  }
}
