# Copy this file to `.env` and fill in real values before running
# `docker compose --profile postgres up -d` (or `--profile mariadb`).
# See wiki/Self-Hosting-Configuration.md for the full reference.

# --- General ----------------------------------------------------------
NODE_ENV=production
# Public URL of the BACKEND API, as reachable from users' browsers.
BASE_URL=http://localhost:4000
# Public URL of the FRONTEND, as reachable from users' browsers.
FRONTEND_URL=http://localhost:3000
# Host ports (left side of docker-compose's "host:container" mappings)
FRONTEND_PORT=3000
BACKEND_PORT=4000

# Baked into the frontend bundle at build time (see docker/frontend.Dockerfile).
# Must match BASE_URL/FRONTEND_URL above for the browser to reach the API
# directly (no reverse proxy in this compose stack).
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000

# Comma-separated list of origins allowed to call the API (CORS). Defaults
# to FRONTEND_URL if left blank.
CORS_ORIGIN=

# --- Database (choose ONE dialect; see database/README.md) ------------
# postgres | mariadb — must match whichever `--profile` you launch with.
DB_DIALECT=postgres
DB_SSL=false

# Postgres profile (docker compose --profile postgres up -d)
POSTGRES_DB=endlessbacklog
POSTGRES_USER=endlessbacklog
POSTGRES_PASSWORD=changeme

# MariaDB profile (docker compose --profile mariadb up -d)
MARIADB_DATABASE=endlessbacklog
MARIADB_USER=endlessbacklog
MARIADB_PASSWORD=changeme
MARIADB_ROOT_PASSWORD=changeme_root

# The actual connection string the backend uses — must reference the
# service name (`postgres` or `mariadb`), not `localhost`, and its
# credentials must match the block above for whichever dialect you picked.
#   Postgres: postgres://<user>:<password>@postgres:5432/<db>
#   MariaDB:  mariadb://<user>:<password>@mariadb:3306/<db>
DATABASE_URL=postgres://endlessbacklog:changeme@postgres:5432/endlessbacklog

# --- Redis --------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Object storage (MinIO, S3-compatible) -------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=endlessbacklog-attachments
S3_ACCESS_KEY=endlessbacklog
S3_SECRET_KEY=changeme123
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=endlessbacklog
MINIO_ROOT_PASSWORD=changeme123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Email (SMTP via Purelymail) -----------------------------------------
# smtp.purelymail.com:465 with SMTP_SECURE=true (implicit TLS), OR
# smtp.purelymail.com:587 with SMTP_SECURE=false (STARTTLS).
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-purelymail-password
MAIL_FROM="EndlessBacklog <you@yourdomain.com>"

# --- Auth -----------------------------------------------------------------
# Generate strong random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=change-this-to-a-random-32+-character-secret
JWT_REFRESH_SECRET=change-this-to-a-different-random-32+-character-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Encrypts TOTP secrets at rest — also 32+ random characters.
TOTP_ENCRYPTION_KEY=change-this-to-another-random-32+-character-secret

# --- OAuth / SSO (optional — leave blank to hide that login button) -------
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
